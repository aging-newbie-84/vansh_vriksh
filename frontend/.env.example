# ── Vansh Vriksha Environment Variables ──────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# OPTION A: Direct OpenAI (simplest — works without n8n)
VITE_OPENAI_API_KEY=sk-your-key-here

# OPTION B: n8n webhook (for advanced workflow with session memory)
# VITE_N8N_WEBHOOK_URL=https://your-n8n.cloud/webhook/family-parse

# Supabase (for persistent tree storage + shareable links)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App name (optional)
VITE_APP_NAME=Vansh Vriksha
